---
import MyLayout from '../layouts/MyLayout.astro';
import PageH1 from '../components/PageH1.astro';

const title = "About FEK.IO"
---
<MyLayout coverImage='/b24-3x.jpg' title={title}>
  <PageH1>About</PageH1>
  <div class="space-y-5">
    <section class="space-y-4">
      <h2 class="text-lg font-bold">Need an iOS, Android, or Node.js application?</h2>
      <img src="./DavidFekke.jpg" alt="David Fekke" class="float-left m-1 h-[7rem] w-[7rem] rounded-full border-[1px] border-[#ffa500] drop-shadow-lg" />
      <p>FEK.IO is the home of David Fekke&apos;s software projects and consulting work. David builds iOS, Android, and Node.js applications, and also works across .NET, and Java web platforms.</p>
      <p>If you are looking for David&apos;s PowerPoint decks and presentation materials, you can find them on the <a href="/slides">slides page</a>.</p>
      <p>If you are interested in custom application development, please get in touch for rates and availability.</p>
      <p>You can also browse the <a href="/flight">flight training resources</a> collected on this site.</p>
    </section>

    <section class="space-y-3">
      <h3 class="text-lg font-bold">Affiliations</h3>
      <ul class="list-disc pl-6">
        <li class="font-bold"><a href="https://www.jaxnode.com">JaxNode</a></li>
        <li class="font-bold"><a href="http://jaxmug.com">JaxMUG</a></li>
        <li class="font-bold"><a href="https://craigpilots.org">Craig Pilots Airport Association</a></li>
      </ul>
    </section>

    <section class="space-y-3">
      <h3 class="text-lg font-bold">Jax Tech Meetups</h3>
      <p><a href="https://polyglotengineer.com">Polyglot Engineer Channel</a> is a YouTube channel David created for software engineers who want to learn a new language or platform.</p>
    </section>

    <section class="space-y-3">
      <h3 class="text-lg font-bold">Aviation</h3>
      <p>David is also a commercial pilot and a licensed remote pilot with single-engine and multi-engine land ratings.</p>
      <p>This site is built with Astro.</p>
    </section>
  </div>
</MyLayout>