---
import '../styles/style.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a2e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <title>Asteroids - Three.js</title>
</head>
<body>
    <div id="ui">
        <div>Score: <span id="score">0</span></div>
        <div>Lives: <span id="lives">3</span></div>
    </div>
    
    <div id="gameOver" class="overlay hidden">
        <div class="panel">
            <h1>Game Over</h1>
            <p>Final Score: <span id="finalScore">0</span></p>
            <button id="restartGameOver">Play Again</button>
        </div>
    </div>
    
    <div id="gameWin" class="overlay hidden">
        <div class="panel">
            <h1>You Win!</h1>
            <p>Final Score: <span id="winScore">0</span></p>
            <button id="restartGameWin">Play Again</button>
        </div>
    </div>
    
    <div id="startScreen" class="overlay">
        <div class="panel">
            <h1>ASTEROIDS</h1>
            <p>Arrow keys or WASD to pilot</p>
            <p>Space to fire &middot; Shift for hyperspace</p>
            <p>Mouse/touch also supported</p>
            <button id="startButton">Start Game</button>
        </div>
    </div>
    
    <div id="rotateHint">Rotate your device for a bigger playfield</div>

    <canvas id="canvas"></canvas>
    
    <script type="module" src="/asteroids.js"></script>
</body>
</html>
