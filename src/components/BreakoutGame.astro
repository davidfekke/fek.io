---
interface Props {
	title?: string;
}

const { title = 'Play Breakout' } = Astro.props;
---

<section class="breakout-game" aria-label={title}>
	<iframe
		src="/breakout"
		title={title}
		loading="lazy"
		allow="autoplay"
	></iframe>
</section>

<style>
	.breakout-game {
		width: min(100%, 900px);
		aspect-ratio: 4 / 3;
		margin: 0 auto 1.25rem;
		overflow: hidden;
		border: 1px solid #0f3460;
		border-radius: 0.75rem;
		box-shadow: 0 0.5rem 1.5rem rgb(15 52 96 / 25%);
	}

	.breakout-game iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
